# Real hunts: GLM on NVIDIA NIM searches the web, Laya classifies locally.
# NIM_API_KEY=

# Offline demo. Remove the first two lines to use Durable Actors and Agent Relay.
CUSTOMS_STORE=file
CUSTOMS_BUS=memory
DECIDER_MODE=mock
REASONER_MODE=mock

# Real models. This key alone switches on Luna search and the Decisions API.
# Leave the *_MODE and CUSTOMS_SOURCE settings unset, because they override it.
# OPENAI_API_KEY=
# REASONER_MODEL=
# REASONER_USD_PER_M_INPUT=
# REASONER_USD_PER_M_OUTPUT=
# LAYA_URL=http://localhost:8000

# Optional: a real search API, used instead of scraping DuckDuckGo and Bing.
# BRAVE_SEARCH_API_KEY=
